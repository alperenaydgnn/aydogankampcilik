# ─── Sunucu ────────────────────────────────────────────────────
PORT=8080
NODE_ENV=production

# ─── CORS — Vercel'deki frontend domain'inizi yazın ────────────
# Birden fazla domain virgülle ayırın: https://a.com,https://b.com
ALLOWED_ORIGIN=https://aydogankampcilik.com

# ─── Supabase (sunucu tarafı) ──────────────────────────────────
# Service Role key — ASLA frontend'e vermeyin, ASLA GitHub'a commitmeyin
# Supabase > Settings > API > service_role (secret)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Blog AI Üretimi ───────────────────────────────────────────
# Groq Cloud > API Keys > Create API Key
GROQ_API_KEY=gsk_...

# Üretim isteği için token — istediğiniz güçlü bir şifre belirleyin
# Örnek: openssl rand -hex 32
BLOG_ADMIN_TOKEN=

# ─── Push Bildirimleri ─────────────────────────────────────────
# VAPID private key (public key frontend'e gider, private sadece burada)
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:info@aydogankampcilik.com
