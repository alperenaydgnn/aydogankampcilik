# ─── Supabase (frontend) ───────────────────────────────────────
# Proje URL'niz — Supabase > Settings > API > Project URL
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Anon/Public key — Supabase > Settings > API > anon / public
# Bu anahtar halka açık olabilir; RLS politikaları güveni sağlar
VITE_SUPABASE_ANON_KEY=eyJ...

# ─── Hava Durumu ───────────────────────────────────────────────
# OpenWeatherMap > API keys (ücretsiz plan yeterli)
# UYARI: VITE_ prefix ile tarayıcıya açık olur; kota izlemeye alın
VITE_OPENWEATHERMAP_API_KEY=

# ─── Push Bildirimleri ─────────────────────────────────────────
# web-push ile üretilmiş VAPID public key (herkese açık olabilir)
VITE_VAPID_PUBLIC_KEY=

# ─── Geliştirme (Replit'e özel, Vercel'de gerekmez) ───────────
# PORT=5173
# BASE_PATH=/
